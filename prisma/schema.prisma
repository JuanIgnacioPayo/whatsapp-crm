generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  role              String     @default("OPERATOR") // OPERATOR, ADMIN
  avatar            String?
  createdAt         DateTime   @default(now())
  assignedCustomers Customer[]
}

model Customer {
  id                 String          @id @default(uuid())
  externalId         String          @unique // WhatsApp number, Messenger PSID, Instagram IGSID
  channel            String          @default("WHATSAPP") // WHATSAPP, MESSENGER, INSTAGRAM
  channelData        String?         // JSON extra data specific to the channel
  name               String?
  profilePictureUrl  String?
  about              String?
  conversationState  String          @default("BOT_ACTIVE") // BOT_ACTIVE, PENDING, IN_ATTENTION, CLOSED
  botStep            String          @default("STEP_1_WELCOME") // STEP_1_WELCOME, STEP_2_PROFILES, BOT_COMPLETED
  profileTag         String?         // Mayorista, Minorista, Soporte
  assignedOperatorId String?
  assignedOperator   User?           @relation(fields: [assignedOperatorId], references: [id])
  messages           Message[]
  scheduledMessages  ScheduledMessage[]
  tags               TagOnCustomer[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Message {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  senderType    String   // CUSTOMER, BOT, OPERATOR
  operatorName  String?  // Nombre del operador si lo envió un humano
  text          String
  status        String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  metaMessageId String?
  channel       String   @default("WHATSAPP") // WHATSAPP, MESSENGER, INSTAGRAM
  createdAt     DateTime @default(now())
}

model ScheduledMessage {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  text        String
  scheduledAt DateTime
  status      String   @default("PENDING") // PENDING, SENT, FAILED, CANCELLED
  createdAt   DateTime @default(now())
}

model Tag {
  id        String          @id @default(uuid())
  name      String          @unique
  color     String          @default("#3B82F6")
  customers TagOnCustomer[]
}

model TagOnCustomer {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

model QuickReply {
  id        String   @id @default(uuid())
  shortcut  String   @unique
  text      String
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String
  description String
  price       Float
  stock       Int      @default(100)
  createdAt   DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BaileysSession {
  sessionId String
  id        String
  data      String

  @@id([sessionId, id])
}
