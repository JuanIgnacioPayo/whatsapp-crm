rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verificar de forma segura si el usuario tiene rol de Administrador
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Configuración del Backend (URL del Túnel)
    match /config/backend {
      allow read: if isAuthenticated();
      allow write: if false; 
    }

    // Colección de Usuarios
    match /users/{userId} {
      // Cualquier usuario autenticado puede leer la lista de usuarios
      allow read: if isAuthenticated();
      
      // Solo puede crear su PROPIO perfil al registrarse
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Puede actualizar su propio perfil (ej. cambiar nombre) o si es admin
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Solo el admin puede eliminar usuarios
      allow delete: if isAdmin();
    }
  }
}
